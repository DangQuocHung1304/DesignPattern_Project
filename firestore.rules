rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function hasAnyRole(roles) {
      return isSignedIn() && getUserData().role in roles;
    }
    
    // ==================== USERS ====================
    
    match /users/{userId} {
      // Anyone can read user info (for doctor lists, etc.)
      allow read: if isSignedIn();
      
      // Only admin and reception can create users
      allow create: if hasAnyRole(['admin', 'reception']);
      
      // Users can update their own data, or admin can update anyone
      allow update: if isOwner(userId) || hasRole('admin');
      
      // Only admin can delete
      allow delete: if hasRole('admin');
      
      // Subcollections
      match /profile/{profileId} {
        allow read: if isOwner(userId) || hasAnyRole(['doctor', 'reception', 'admin']);
        allow write: if isOwner(userId) || hasRole('admin');
      }
      
      match /specialties/{specialtyId} {
        allow read: if true;  // Public
        allow write: if hasRole('admin');
      }
    }
    
    // ==================== APPOINTMENTS ====================
    
    match /appointments/{appointmentId} {
      // Read: patient, doctor, reception, admin
      allow read: if isSignedIn();
      
      // Create: patient (self), reception, admin
      allow create: if isSignedIn();
      
      // Update: patient (own), doctor (assigned), reception, admin
      allow update: if isSignedIn() && (
        isOwner(resource.data.patientId) ||
        isOwner(resource.data.doctorId) ||
        hasAnyRole(['reception', 'admin'])
      );
      
      // Delete: admin only
      allow delete: if hasRole('admin');
      
      // History subcollection (read-only, written by Cloud Functions)
      match /history/{historyId} {
        allow read: if isSignedIn();
        allow write: if false;  // Only Cloud Functions
      }
    }
    
    // ==================== SPECIALTIES ====================
    
    match /specialties/{specialtyId} {
      allow read: if true;  // Public
      allow write: if hasRole('admin');
    }
    
    // ==================== SERVICES ====================
    
    match /services/{serviceId} {
      allow read: if true;  // Public
      allow write: if hasRole('admin');
    }
    
    // ==================== DOCTOR SCHEDULES ====================
    
    match /doctorSchedules/{scheduleId} {
      allow read: if true;  // Anyone can see availability
      allow create, update: if hasRole('doctor') || hasRole('admin');
      allow delete: if hasRole('admin');
    }
    
    // ==================== ENCOUNTERS ====================
    
    match /encounters/{encounterId} {
      // Read: patient (own), doctor (assigned), reception, admin
      allow read: if isSignedIn() && (
        isOwner(resource.data.patientId) ||
        isOwner(resource.data.doctorId) ||
        hasAnyRole(['reception', 'admin'])
      );
      
      // Write: doctor, admin
      allow create, update: if hasAnyRole(['doctor', 'admin']);
      allow delete: if hasRole('admin');
      
      // Subcollections (prescriptions, lab requests, imaging requests)
      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/encounters/$(encounterId)).data.patientId) ||
          hasAnyRole(['doctor', 'lab', 'radiology', 'admin'])
        );
        allow write: if hasAnyRole(['doctor', 'admin']);
        
        // Nested subcollections (items, results)
        match /{nested}/{nestedId} {
          allow read: if isSignedIn();
          allow write: if hasAnyRole(['doctor', 'lab', 'radiology', 'admin']);
        }
      }
    }
    
    // ==================== INVOICES ====================
    
    match /invoices/{invoiceId} {
      // Read: patient (own), accountant, reception, admin
      allow read: if isSignedIn() && (
        isOwner(resource.data.patientId) ||
        hasAnyRole(['accountant', 'reception', 'admin'])
      );
      
      // Write: accountant, reception, admin
      allow create, update: if hasAnyRole(['accountant', 'reception', 'admin']);
      allow delete: if hasRole('admin');
      
      // Subcollections (items, payments)
      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/invoices/$(invoiceId)).data.patientId) ||
          hasAnyRole(['accountant', 'reception', 'admin'])
        );
        allow write: if hasAnyRole(['accountant', 'reception', 'admin']);
      }
    }
    
    // ==================== NOTIFICATIONS ====================
    
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;  // Only Cloud Functions
    }
    
    // ==================== RATINGS ====================
    
    match /ratings/{ratingId} {
      allow read: if true;  // Public ratings
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.patientId);
    }
    
    // ==================== PAYROLL ====================
    
    match /payrollPeriods/{periodId} {
      allow read, write: if hasAnyRole(['accountant', 'admin']);
      
      match /entries/{entryId} {
        // Staff can read their own payroll
        allow read: if isOwner(resource.data.staffUserId) || hasAnyRole(['accountant', 'admin']);
        allow write: if hasAnyRole(['accountant', 'admin']);
      }
    }
    
    // ==================== FILES ====================
    
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.uploadedBy) || hasRole('admin');
    }
    
    // ==================== ACTIVITY LOGS ====================
    
    match /activityLogs/{logId} {
      allow read: if hasRole('admin');
      allow write: if false;  // Only Cloud Functions
    }
  }
}